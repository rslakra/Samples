NODE ?= node
ROOT := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
DATA := $(ROOT)data
MIN_NODE_MAJOR ?= 18

.DEFAULT_GOAL := help

.PHONY: help check start builtin file promise stream all data clean reset

help: ## Show available commands
	@echo "Node.js Components — plain CommonJS demos of Node core modules"
	@echo ""
	@echo "Usage: make [target]"
	@echo ""
	@grep -E '^[a-zA-Z0-9_-]+:.*##' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*## "}; {printf "  \033[36m%-10s\033[0m %s\n", $$1, $$2}'
	@echo ""
	@echo "Quick start:"
	@echo "  make check"
	@echo "  make start"
	@echo "  make all"
	@echo ""
	@echo "No build step and no dependencies — only Node.js built-in modules."

check: ## Verify Node.js is installed and new enough (18+)
	@command -v $(NODE) >/dev/null 2>&1 || (echo "Node.js not found. Install from https://nodejs.org or 'brew install node'." && exit 1)
	@version=$$($(NODE) -v); \
	major=$$(echo $$version | sed 's/^v//' | cut -d. -f1); \
	if [ "$$major" -lt "$(MIN_NODE_MAJOR)" ]; then \
		echo "Node $$version found, but >= v$(MIN_NODE_MAJOR) is recommended."; \
		exit 1; \
	fi; \
	echo "Node $$version OK"

start: check ## Run server.js (entry point — math module demo)
	cd $(ROOT) && $(NODE) server.js

builtin: check ## Run core/builtin.js (os, path and CPU details)
	cd $(ROOT) && $(NODE) core/builtin.js

file: check data ## Run core/file.js (callback fs read/write -> data/reply.txt)
	cd $(ROOT) && $(NODE) core/file.js

promise: check data ## Run core/promise.js (fs.promises -> data/promises.txt)
	cd $(ROOT) && $(NODE) core/promise.js
	@$(MAKE) --no-print-directory data

stream: check ## Run core/stream.js (read/write streams -> data/large-write.txt)
	cd $(ROOT) && $(NODE) core/stream.js

all: start builtin file promise stream ## Run every demo in order

data: ## Recreate data/small.txt if a demo deleted it
	@if [ ! -f "$(DATA)/small.txt" ]; then \
		mkdir -p "$(DATA)"; \
		printf 'this is first line.\nthis is second line.\n' > "$(DATA)/small.txt"; \
		echo "Restored $(DATA)/small.txt"; \
	fi

clean: ## Remove files generated by the demos
	rm -f "$(DATA)/reply.txt" "$(DATA)/promises.txt" "$(DATA)/large-write.txt"
	@echo "Generated data files removed."

reset: clean data ## Clean generated files and restore data/small.txt
	@echo "Workspace reset."
